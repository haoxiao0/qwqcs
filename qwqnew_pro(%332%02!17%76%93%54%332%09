            local handle = tool and (tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart"))
            
            if handle then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        -- 同步过滤队友与黑名单
                        if HB_Player_TeamCheck and p.Team == LocalPlayer.Team then continue end
                        if table.find(HB_Player_Blacklist, p.Name) then continue end
                        
                        local targetHrp = p.Character:FindFirstChild("HumanoidRootPart")
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        
                        if targetHrp and hum and hum.Health > 0 then
                            -- 利用数学公式计算距离
                            local dist = (targetHrp.Position - handle.Position).Magnitude
                            
                            -- 如果在目标扩大的碰撞箱范围内 (边长的一半 + 6 Studs 的武器容错长度)
                            if dist <= (HB_Player_Size / 2) + 6 then
                                task.spawn(function()
                                    firetouchinterest(handle, targetHrp, 0) -- 模拟接触
                                    task.wait(0.01)
                                    firetouchinterest(handle, targetHrp, 1) -- 模拟接触结束
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end)





