-- 🟣 NPC ESP 系统 (极限 UI 渲染优化版)
-- ==========================================
local NPC_Cache = {}

local function IsValidNPC(model)
    if not model or not model:IsA("Model") then return false end
    if not model:FindFirstChild("HumanoidRootPart") then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    return true
end

local function addNPCESP(npcModel)
    if NPC_Cache[npcModel] then return end
    
    local data = {}
    
    -- 💡 核心优化 1：使用透明 Frame 作为总容器，每帧只需移动容器 1 次，内部控件自动跟随
    local container = Instance.new("Frame")
    container.Name = genRandomName()
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(0, 0, 0, 0)
    container.Visible = false
    container.Parent = MasterESPContainer
    data.Container = container
    data.IsVisible = false -- 缓存可见性状态

    local highlight = Instance.new("Highlight")
    highlight.Name = genRandomName()
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0.1
    highlight.Adornee = npcModel
    highlight.Parent = SafeContainer
    highlight.Enabled = false
    data.Highlight = highlight

    -- 名字显示 (相对于中心点向上偏移 35px)
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = genRandomName()
    nameLabel.BackgroundTransparency = 1
    nameLabel.Size = UDim2.new(0, 200, 0, 12)
    nameLabel.AnchorPoint = Vector2.new(0.5, 1)
    nameLabel.Position = UDim2.new(0, 0, 0, -35)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 11
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Parent = container
    data.Name = nameLabel

    -- 血量数值 (相对于中心点向上偏移 20px)
    local hpLabel = Instance.new("TextLabel")
    hpLabel.Name = genRandomName()
    hpLabel.BackgroundTransparency = 1
    hpLabel.Size = UDim2.new(0, 200, 0, 12)
    hpLabel.AnchorPoint = Vector2.new(0.5, 1)
    hpLabel.Position = UDim2.new(0, 0, 0, -20)
    hpLabel.Font = Enum.Font.GothamBold
    hpLabel.TextSize = 10
    hpLabel.TextStrokeTransparency = 0
    hpLabel.Parent = container
    data.HealthText = hpLabel

    -- 血量条背景 (固定宽度 50，居中，相对于中心点向上偏移 15px)
    local hpBg = Instance.new("Frame")
    hpBg.Name = genRandomName()
    hpBg.BorderSizePixel = 0
    hpBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    hpBg.Size = UDim2.new(0, 50, 0, 3)
    hpBg.AnchorPoint = Vector2.new(0.5, 1)
    hpBg.Position = UDim2.new(0, 0, 0, -15)
    hpBg.Parent = container
    local bgCorner = Instance.new("UICorner", hpBg)
    bgCorner.CornerRadius = UDim.new(1, 0)
    data.HealthBg = hpBg

    -- 血量条填充
    local hpFill = Instance.new("Frame")
    hpFill.Name = genRandomName()
    hpFill.BorderSizePixel = 0
    hpFill.Size = UDim2.new(1, 0, 1, 0)
    hpFill.Parent = hpBg
    local fillCorner = Instance.new("UICorner", hpFill)
    fillCorner.CornerRadius = UDim.new(1, 0)
    data.HealthFill = hpFill
    
    -- 距离显示 (相对于中心点向下偏移 5px)
    local distLabel = Instance.new("TextLabel")
    distLabel.Name = genRandomName()
    distLabel.BackgroundTransparency = 1
    distLabel.Size = UDim2.new(0, 200, 0, 15)
    distLabel.AnchorPoint = Vector2.new(0.5, 0)
    distLabel.Position = UDim2.new(0, 0, 0, 5)
    distLabel.Font = Enum.Font.GothamBold
    distLabel.TextSize = 12
    distLabel.TextStrokeTransparency = 0
    distLabel.Parent = container
    data.Dist = distLabel

    -- 💡 核心优化 2：数据状态缓存 (避免每帧重复赋值触发重绘)
    data.LastHP = -1
    data.LastDist = -1
    data.LastColor = nil
    data.LastName = ""

    NPC_Cache[npcModel] = data

    local deathConn
    deathConn = npcModel.AncestryChanged:Connect(function(_, parent)
        if not parent then
            if NPC_Cache[npcModel] then
                NPC_Cache[npcModel].Container:Destroy()
                if NPC_Cache[npcModel].Highlight then NPC_Cache[npcModel].Highlight:Destroy() end
                NPC_Cache[npcModel] = nil
            end
            if deathConn then deathConn:Disconnect() end
        end
    end)
end

