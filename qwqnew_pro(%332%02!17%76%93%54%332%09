-- 核心：玩家实体映射表 (彻底解决重名导致的传错人BUG)
local TP_PlayerMap = {}

-- 核心寻人函数 (直接从映射表提取实体)
local function GetTPTargetPlayer()
    if not TP_SelectedString or TP_SelectedString == "无玩家" then return nil end
    local target = TP_PlayerMap[TP_SelectedString]
    -- 确保玩家没有退服
    if target and target.Parent then return target end
    return nil
end

-- 动态刷新玩家列表函数 (带智能排版)
local function UpdateTPPlayerList()
    table.clear(TP_PlayerMap) -- 清空旧的映射
    local list = {}
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local displayStr = ""
            if TP_TargetMode == "用户名" then
                displayStr = p.Name
            elseif TP_TargetMode == "姓名" then
                -- 显示格式为 "姓名 (@用户名)"
                displayStr = string.format("%s (@%s)", p.DisplayName, p.Name)
            end
            
            table.insert(list, displayStr)
            TP_PlayerMap[displayStr] = p -- 将文字绑定给玩家实体
        end
    end
    
    if #list == 0 then list = {"无玩家"} end
    if Options.TP_PlayerDropdown then 
        Options.TP_PlayerDropdown:SetValues(list) 
        if not table.find(list, Options.TP_PlayerDropdown.Value) then
            Options.TP_PlayerDropdown:SetValue(list[1])
        end
    end
end

