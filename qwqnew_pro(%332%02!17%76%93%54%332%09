-- 🟢 核心渲染循环
-- ==========================================
RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    if not cam then return end

    for player, data in pairs(PlayerESP_Cache) do
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local hum = character and character:FindFirstChild("Humanoid")
        
        local isAlive = hrp and hum and hum.Health > 0

        if data.Highlight then
            if isAlive and Options.HighlightESP and Options.HighlightESP.Value then
                data.Highlight.Adornee = character
                data.Highlight.Enabled = true
                if Options.HighlightColor then
                    data.Highlight.FillColor = Options.HighlightColor.Value
                    data.Highlight.OutlineColor = Options.HighlightColor.Value
                end
            else
                data.Highlight.Enabled = false
            end
        end

        if isAlive then
            local pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
            
            if onScreen then
                local topPos = cam:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3.5, 0))
                local bottomPos = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.5, 0))
                local height = math.abs(bottomPos.Y - topPos.Y)
                local width = height * 0.65

                local boxX = pos.X - width / 2
                local boxY = topPos.Y

                -- 1. 方框
                if Options.BoxESP and Options.BoxESP.Value then
                    data.Box.Visible = true
                    data.Box.Size = UDim2.new(0, width, 0, height)
                    data.Box.Position = UDim2.new(0, boxX, 0, boxY)
                    data.BoxStroke.Color = Options.BoxColor.Value
                else
                    data.Box.Visible = false
                end

                -- 2. 射线
                if Options.RayESP and Options.RayESP.Value then
                    data.Ray.Visible = true
                    local origin = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                    local target = Vector2.new(pos.X, pos.Y)
                    local dir = target - origin
                    local distance = dir.Magnitude
                    local center = (origin + target) / 2
                    
                    data.Ray.Size = UDim2.new(0, distance, 0, 2)
                    data.Ray.Position = UDim2.new(0, center.X, 0, center.Y)
                    data.Ray.Rotation = math.deg(math.atan2(dir.Y, dir.X))
                    data.Ray.BackgroundColor3 = Options.RayColor.Value
                else
                    data.Ray.Visible = false
                end

                -- 📌 动态推移坐标计算 (防重叠)
                local currentY = boxY - 4 

                -- 3. 血条和数值
                if Options.HealthESP and Options.HealthESP.Value then
                    local maxHp = math.max(hum.MaxHealth, 1)
                    local curHp = hum.Health
                    local hpPercent = math.clamp(curHp / maxHp, 0, 1)

                    -- 向上推移 3px 放血条 (3px厚度圆角)
                    currentY = currentY - 3
                    data.HealthBg.Visible = true
                    data.HealthBg.Size = UDim2.new(0, math.max(width, 40), 0, 3)
                    data.HealthBg.Position = UDim2.new(0, pos.X - math.max(width, 40)/2, 0, currentY)
                    data.HealthFill.Size = UDim2.new(hpPercent, 0, 1, 0)
                    data.HealthFill.BackgroundColor3 = Options.HealthBarColor.Value

                    -- 向上推移 12px 放血量数值
                    currentY = currentY - 12
                    data.HealthText.Visible = true
                    data.HealthText.Text = formatHealth(curHp) .. " / " .. formatHealth(maxHp)
                    data.HealthText.Position = UDim2.new(0, pos.X - 100, 0, currentY)
                    data.HealthText.TextColor3 = Options.HealthBarColor.Value
                else
                    data.HealthText.Visible = false
                    data.HealthBg.Visible = false
                end

                -- 4. 名字 (叠在最上面)
                if Options.NameESP and Options.NameESP.Value then
                    currentY = currentY - 12
                    data.Name.Visible = true
                    data.Name.Text = player.Name
                    data.Name.Position = UDim2.new(0, pos.X - 100, 0, currentY)
                    data.Name.TextColor3 = Options.TextColor.Value
                else
                    data.Name.Visible = false
                end

                -- 5. 距离 (方框下方)
                if Options.DistanceESP and Options.DistanceESP.Value then
                    data.Dist.Visible = true
                    local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if localHrp then
                        local dist = math.floor((hrp.Position - localHrp.Position).Magnitude)
                        data.Dist.Text = dist .. " M"
                        data.Dist.Position = UDim2.new(0, pos.X - 100, 0, bottomPos.Y + 5)
                        data.Dist.TextColor3 = Options.TextColor.Value
                    end
                else
                    data.Dist.Visible = false
                end
            else
                data.Box.Visible = false; data.Ray.Visible = false; data.Name.Visible = false
                data.HealthText.Visible = false; data.HealthBg.Visible = false; data.Dist.Visible = false
            end
        else
            data.Box.Visible = false; data.Ray.Visible = false; data.Name.Visible = false
            data.HealthText.Visible = false; data.HealthBg.Visible = false; data.Dist.Visible = false
        end
    end
end)

