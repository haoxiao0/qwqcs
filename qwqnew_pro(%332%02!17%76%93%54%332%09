-- 核心：计算目标 CFrame
local function GetTeleportCFrame(targetHRP)
    if TP_Direction == "前面" then return targetHRP.CFrame * CFrame.new(0, 0, -TP_Distance)
    elseif TP_Direction == "后面" then return targetHRP.CFrame * CFrame.new(0, 0, TP_Distance)
    elseif TP_Direction == "左边" then return targetHRP.CFrame * CFrame.new(-TP_Distance, 0, 0)
    elseif TP_Direction == "右边" then return targetHRP.CFrame * CFrame.new(TP_Distance, 0, 0)
    elseif TP_Direction == "上面" then return targetHRP.CFrame * CFrame.new(0, TP_Distance, 0)
    elseif TP_Direction == "下面" then return targetHRP.CFrame * CFrame.new(0, -TP_Distance, 0)
    end
    return targetHRP.CFrame
end

