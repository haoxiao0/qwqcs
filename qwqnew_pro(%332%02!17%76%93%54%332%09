-- ==========================================
-- 🔒 视角锁模块 (生成/销毁悬浮按键 + 双贴图版)
-- ==========================================
do
    -- 1. 专属的 50 位独立乱码生成器
    local function GetModuleEncryptedName()
        local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+ᗜ𖥦ฅ ̳• ·̫ • ̳ฅ"
        local result = ""
        for i = 1, 50 do
            local randIndex = math.random(1, #chars)
            result = result .. string.sub(chars, randIndex, randIndex)
        end
        return result
    end

    -- 2. 安全获取注入器专属 UI 容器
    local function GetSafeUIContainer()
        if gethui then
            local s, r = pcall(gethui)
            if s and r then return r end
        end
        local s, r = pcall(function() return game:GetService("CoreGui") end)
        if s and r then return r end
        return game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    end

    -- 👇👇👇 在这里填入你的透明底贴图 ID 👇👇👇
    local IMAGE_OFF = "rbxassetid://137975580404687"  -- 视角锁关闭时的贴图
    local IMAGE_ON  = "rbxassetid://113586405092215"  -- 视角锁开启时的贴图

    -- 变量声明
    local faceLockConnection = nil
    local isFaceLockActive = false
    local isButtonDraggable = false
    
    local moduleScreenGui = nil
    local keyIconButton = nil
    local dragConnections = {}

    -- 核心逻辑：停止视角锁定
    local function StopFaceLock()
        isFaceLockActive = false
        if faceLockConnection then
            faceLockConnection:Disconnect()
            faceLockConnection = nil
        end
        if keyIconButton then
            keyIconButton.Image = IMAGE_OFF
        end
    end

    -- 核心逻辑：开启/关闭视角锁定
    local function ToggleFaceLock()
        isFaceLockActive = not isFaceLockActive
        if isFaceLockActive then
            if keyIconButton then keyIconButton.Image = IMAGE_ON end
            faceLockConnection = RunService.RenderStepped:Connect(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp and Camera then
                    local camLook = Camera.CFrame.LookVector
                    hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(camLook.X, 0, camLook.Z))
                end
            end)
        else
            StopFaceLock()
        end
    end

    -- 3. 彻底销毁悬浮 UI
    local function DestroyUI()
        StopFaceLock() -- 销毁UI时同时强制关闭视角锁，防卡死
        
        -- 清理拖拽事件内存
        for _, conn in ipairs(dragConnections) do 
            pcall(function() conn:Disconnect() end) 
        end
        table.clear(dragConnections)

        if moduleScreenGui then
            moduleScreenGui:Destroy()
            moduleScreenGui = nil
            keyIconButton = nil
        end
    end

    -- 4. 生成悬浮 UI
    local function CreateUI()
        DestroyUI() -- 确保旧的被摧毁
        
        moduleScreenGui = Instance.new("ScreenGui")
        moduleScreenGui.Name = GetModuleEncryptedName()
        moduleScreenGui.ResetOnSpawn = false
        moduleScreenGui.Parent = GetSafeUIContainer()

        keyIconButton = Instance.new("ImageButton")
        keyIconButton.Name = GetModuleEncryptedName()
        keyIconButton.Size = UDim2.new(0, 55, 0, 55)
        keyIconButton.Position = UDim2.new(0.8, 0, 0.5, 0)
        keyIconButton.BackgroundTransparency = 1 -- 背景彻底透明，只显示贴图
        keyIconButton.Image = IMAGE_OFF -- 初始状态
        keyIconButton.Parent = moduleScreenGui

        -- 绑定点击事件
        keyIconButton.MouseButton1Click:Connect(ToggleFaceLock)

        -- 绑定拖拽逻辑
        local dragging, dragInput, dragStart, startPos
        table.insert(dragConnections, keyIconButton.InputBegan:Connect(function(input)
            if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and isButtonDraggable then
                dragging = true
                dragStart = input.Position
                startPos = keyIconButton.Position
            end
        end))

        table.insert(dragConnections, keyIconButton.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end))

        table.insert(dragConnections, UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging and isButtonDraggable then
                local delta = input.Position - dragStart
                keyIconButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end))

        table.insert(dragConnections, UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))
    end

    -- 5. 菜单 UI 排版绑定
    Tabs.FOV:AddSection("视角锁")

    Tabs.FOV:AddToggle("FaceLockSpawnToggle", {
        Title = "显示/关闭 悬浮按键",
        Default = false,
        Callback = function(value)
            if value then
                CreateUI()
            else
                DestroyUI()
            end
        end
    })

    Tabs.FOV:AddToggle("FaceLockDragToggle", {
        Title = "解锁悬浮按钮位置 (允许拖动)",
        Default = false,
        Callback = function(value)
            isButtonDraggable = value
        end
    })
end


