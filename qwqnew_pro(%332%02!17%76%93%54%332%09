-- 🟢 极限优化的渲染循环
RunService.RenderStepped:Connect(function()
    -- 提取 UI 选项到循环外，避免在百个对象的循环体中重复查表
    local opt_master = Options.NPC_Master and Options.NPC_Master.Value
    if not opt_master then return end

    local cam = workspace.CurrentCamera
    if not cam then return end

    local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local localPos = localHrp and localHrp.Position or cam.CFrame.Position

    local opt_name = Options.NPC_NameToggle and Options.NPC_NameToggle.Value
    local opt_dist = Options.NPC_DistToggle and Options.NPC_DistToggle.Value
    local opt_hp = Options.NPC_Health and Options.NPC_Health.Value
    local opt_hl = Options.NPC_HighlightToggle and Options.NPC_HighlightToggle.Value
    local opt_col = Options.NPC_Color and Options.NPC_Color.Value or MacaronBlue

    for npcModel, data in pairs(NPC_Cache) do
        local hrp = npcModel:FindFirstChild("HumanoidRootPart")
        local hum = npcModel:FindFirstChildOfClass("Humanoid")
        
        -- 无效或死亡直接隐藏容器，不废话
        if not hrp or not hum or hum.Health <= 0 then
            if data.IsVisible then
                data.Container.Visible = false
                data.IsVisible = false
                data.Highlight.Enabled = false
            end
            continue
        end

        -- 距离剔除：1500米以外不计算
        local distToPlayer = (hrp.Position - localPos).Magnitude
        if distToPlayer > 1500 then
            if data.IsVisible then
                data.Container.Visible = false
                data.IsVisible = false
                data.Highlight.Enabled = false
            end
            continue
        end

        -- 单点透视计算 (舍弃了之前为了算宽度搞的顶部底部 3 次计算)
        local pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            if data.IsVisible then
                data.Container.Visible = false
                data.IsVisible = false
                data.Highlight.Enabled = false
            end
            continue
        end

        -- 显示容器
        if not data.IsVisible then
            data.Container.Visible = true
            data.IsVisible = true
        end

        -- 移动主容器 (一次性移动里面的名字、血条、距离)
        data.Container.Position = UDim2.new(0, pos.X, 0, pos.Y)

        -- 高亮处理与颜色缓存更新
        if opt_hl then
            if not data.Highlight.Enabled then data.Highlight.Enabled = true end
            if data.LastColor ~= opt_col then
                data.Highlight.FillColor = opt_col
                data.Highlight.OutlineColor = opt_col
            end
        else
            if data.Highlight.Enabled then data.Highlight.Enabled = false end
        end

        -- 更新字体颜色 (仅当颜色变化时)
        if data.LastColor ~= opt_col then
            data.LastColor = opt_col
            data.Name.TextColor3 = opt_col
            data.HealthText.TextColor3 = opt_col
            data.HealthFill.BackgroundColor3 = opt_col
            data.Dist.TextColor3 = opt_col
        end

        -- 处理血量 (仅当血量数值变化时重绘 UI)
        if opt_hp then
            data.HealthBg.Visible = true
            data.HealthText.Visible = true
            
            local curHp = hum.Health
            local maxHp = math.max(hum.MaxHealth, 1)
            
            if data.LastHP ~= curHp then
                data.LastHP = curHp
                local hpPercent = math.clamp(curHp / maxHp, 0, 1)
                data.HealthFill.Size = UDim2.new(hpPercent, 0, 1, 0)
                data.HealthText.Text = formatHealth(curHp) .. " / " .. formatHealth(maxHp)
            end
        else
            data.HealthBg.Visible = false
            data.HealthText.Visible = false
        end

        -- 处理名称
        if opt_name then
            data.Name.Visible = true
            local curName = npcModel.Name
            if data.LastName ~= curName then
                data.LastName = curName
                data.Name.Text = curName
            end
        else
            data.Name.Visible = false
        end
        
        -- 处理距离 (仅当米数整数变化时重绘文字)
        if opt_dist then
            data.Dist.Visible = true
            local distFloor = math.floor(distToPlayer)
            if data.LastDist ~= distFloor then
                data.LastDist = distFloor
                data.Dist.Text = distFloor .. " M"
            end
        else
            data.Dist.Visible = false
        end
    end
end)

