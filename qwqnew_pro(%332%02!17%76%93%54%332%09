    ["普通方块"] = Enum.Material.SmoothPlastic,
    ["玻璃材质"] = Enum.Material.Glass,
    ["金属材质"] = Enum.Material.Metal,
    ["霓虹发光"] = Enum.Material.Neon,
    ["半透力场"] = Enum.Material.ForceField
}

-- ==========================================
-- 🛠️ 核心辅助与恢复函数
-- ==========================================
-- 保存原始属性
local function SaveOriginalState(hrp)
    if not OriginalHitboxStates[hrp] then
        OriginalHitboxStates[hrp] = {
            Size = hrp.Size,
            Transparency = hrp.Transparency,
            Color = hrp.Color,
            Material = hrp.Material,
            CanCollide = hrp.CanCollide
        }
    end
end

-- 恢复原始属性
local function RestoreHitbox(hrp)
    local state = OriginalHitboxStates[hrp]
    if state then
        pcall(function()
            hrp.Size = state.Size
            hrp.Transparency = state.Transparency
            hrp.Color = state.Color
            hrp.Material = state.Material
            hrp.CanCollide = state.CanCollide
        end)
    end
end

-- 恢复所有玩家
local function RestoreAllPlayers()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then RestoreHitbox(hrp) end
        end
    end
end

