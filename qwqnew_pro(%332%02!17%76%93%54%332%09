Tabs.Teleport:AddToggle("AutoFlingToggle", {
    Title = "循环监测甩飞",
    Description = "甩飞成功后会等待目标复活，然后再甩，不掉帧",
    Default = false,
    Callback = function(state)
        AutoFlingLoop = state
        if state then
            if not SelectedFlingPlayer then
                Fluent:Notify({ Title = "提示", Content = "请先在上方选择一个目标", Duration = 3 })
                Options.AutoFlingToggle:SetValue(false)
                return
            end
            
            Fluent:Notify({ Title = "已开启", Content = "正在持续监测并甩飞 " .. SelectedFlingPlayer.Name, Duration = 3 })
            
            task.spawn(function()
                while AutoFlingLoop and SelectedFlingPlayer and SelectedFlingPlayer.Parent do
                    local char = SelectedFlingPlayer.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    
                    if char and hum and hum.Health > 0 then
                        SkidFling(SelectedFlingPlayer)
                        
                        repeat task.wait(0.5) 
                        until not AutoFlingLoop 
                           or not SelectedFlingPlayer.Parent 
                           or not SelectedFlingPlayer.Character 
                           or not SelectedFlingPlayer.Character:FindFirstChildOfClass("Humanoid") 
                           or SelectedFlingPlayer.Character:FindFirstChildOfClass("Humanoid").Health <= 0
                    end
                    task.wait(1) 
                end
                
                if AutoFlingLoop then
                    Options.AutoFlingToggle:SetValue(false)
                    Fluent:Notify({ Title = "提示", Content = "目标已离开服务器，监测已关闭", Duration = 4 })
                end
            end)
        end
    end
})

