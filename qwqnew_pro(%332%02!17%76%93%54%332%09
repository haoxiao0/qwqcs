-- 【安全核心】：安全获取 UI 容器
local function GetSafeUIContainer()
    if gethui then
        local s, r = pcall(gethui)
        if s and r then return r end
    end
    local s, r = pcall(function() return game:GetService("CoreGui") end)
    if s and r then return r end
    return LocalPlayer:WaitForChild("PlayerGui")
end

