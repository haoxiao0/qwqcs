-- 🟢 传送与环绕 核心渲染循环
-- ==========================================
RunService.Heartbeat:Connect(function(deltaTime)
    if TP_ContinuousEnabled then
        local target = GetTPTargetPlayer()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myHRP then
                myHRP.CFrame = GetTeleportCFrame(target.Character.HumanoidRootPart)
                myHRP.Velocity = Vector3.new(0, 0, 0) 
            end
        end
    end

    if TP_CircleEnabled then
        local target = GetTPTargetPlayer()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myHRP then
                TP_CircleAngle = TP_CircleAngle + (math.pi * 2 * 0.5 * deltaTime) 
                if TP_CircleAngle >= math.pi * 2 then TP_CircleAngle = TP_CircleAngle - (math.pi * 2) end
                
                local targetPos = target.Character.HumanoidRootPart.Position
                local offsetX = math.cos(TP_CircleAngle) * TP_Distance
                local offsetZ = math.sin(TP_CircleAngle) * TP_Distance
                
                local newPos = targetPos + Vector3.new(offsetX, 0, offsetZ)
                myHRP.CFrame = CFrame.new(newPos, targetPos)
                myHRP.Velocity = Vector3.new(0, 0, 0)
            end
        end
    end
end)

