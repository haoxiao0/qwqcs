-- 🟢 自瞄相机渲染引擎
-- ==========================================
RunService.RenderStepped:Connect(function()
    if AimbotRainbowFOV then
        local hue = tick() % 5 / 5
        UIStroke.Color = Color3.fromHSV(hue, 1, 1)
    elseif UIStroke.Color ~= AimbotFOVColor then
        UIStroke.Color = AimbotFOVColor
    end

    -- 无论开哪种自瞄，FOV圈共用这一个
    FOVCircle.Visible = GlobalAimbotEnabled or NPC_Aimbot_Enabled

    if GlobalAimbotEnabled or NPC_Aimbot_Enabled then
        local targetPart, isPlayerTarget = GetClosestEntity()
        if targetPart then
            local newCFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
            -- 根据目标是玩家还是NPC，自动调用对应的平滑度
            local smooth = isPlayerTarget and AimbotSmoothness or NPC_Aimbot_Smoothness
            Camera.CFrame = Camera.CFrame:Lerp(newCFrame, smooth)
        end
    elseif SingleAimbotEnabled then
        UpdateSingleTarget()
        if targetSinglePlayer and targetSinglePlayer.Character then
            local humanoid = targetSinglePlayer.Character:FindFirstChild("Humanoid")
            local targetPart = targetSinglePlayer.Character:FindFirstChild(AimbotTargetPart)
            if humanoid and humanoid.Health > 0 and targetPart then
                local newCFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
                Camera.CFrame = Camera.CFrame:Lerp(newCFrame, AimbotSmoothness)
            end
        end
    end
end)


